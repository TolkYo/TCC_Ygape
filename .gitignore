# Environment / secrets
.env
.env.*
!.env.example

# Token cache ANA
backend/.ana_token.json

# Saidas intermediarias dos coletores (quando executados a partir de backend/)
backend/*.csv
backend/relatorio_estacoes.txt

# Nota: os CSV curados em planilhas/ sao versionados de proposito (entregaveis do TCC).

# Dados brutos pesados (GeoPackage, NetCDF, bancos) — regeneraveis pelos coletores
data/

# Logs de download
backend/*.log
backend/*.err

# Estado local (sessão/configuração da ferramenta)
.contexto/
.opencode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Sistemas operacionais
.DS_Store
Thumbs.db
desktop.ini

# Caches de ferramentas / build
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
*.tsbuildinfo
build/

# Backups e artefatos de merge
*.bak
*.bak.*
*.orig
*.rej

# Deploy: stack com segredos preenchidos (use ygape.yml.example)
deploy/swarm/ygape.yml
