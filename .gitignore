data/

# Logs de download
backend/*.log
backend/*.err

# Estado local (sessão/configuração da ferramenta)
.contexto/
.opencode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# IDE
.vscode/
.idea/
