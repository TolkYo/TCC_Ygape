# Segredo de assinatura dos tokens JWT (gere com: python -c "import secrets; print(secrets.token_urlsafe(48))")
HIDROWIZE_TOKEN_SECRET=

# Tempo de vida do token, em segundos (padrao: 8 horas)
HIDROWIZE_TOKEN_TTL_SECONDS=28800

# Origens liberadas no CORS (separadas por virgula)
HIDROWIZE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost:8080,http://127.0.0.1:8080

# Caminhos opcionais dos bancos (padrao: data/hidrowize.db e data/hidrowize_api.db)
# HIDROWIZE_DATA_DB=
# HIDROWIZE_AUTH_DB=

# API key gratuita do hydroweb.next (CNES/LEGOS) para os coletores de satelite
HYDROWEB_API_KEY=

# PostgreSQL/PostGIS de producao (VPS Hostinger, container Docker "ygape-db")
# O .env local guarda os valores reais; aqui ficam apenas os nomes das chaves.
# HIDROWIZE_PG_HOST=
# HIDROWIZE_PG_PORT=5432
# HIDROWIZE_PG_DB=ygape
# HIDROWIZE_PG_USER=ygape
# HIDROWIZE_PG_PASSWORD=
